{
  "name": "cinema-watch",
  "version": "0.0.0",
  "description": "Cacce ai biglietti dei cinema italiani (UCI, The Space, i cinema Webtic e 18Tickets): avvisi Telegram con la pianta della sala quando escono gli spettacoli o si liberano posti buoni.",
  "license": "MIT",
  "author": "Filippo Scatigna (PilaScat)",
  "repository": {
    "type": "git",
    "url": "https://github.com/PilaScat/cinema-watch.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:mutation": "stryker run",
    "build:icons": "node scripts/build-icons.mjs",
    "build:css": "node scripts/build-css.mjs",
    "sync:icons": "node scripts/sync-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@resvg/resvg-js": "2.6.2",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "lucide-static": "1.60.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
