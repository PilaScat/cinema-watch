{
  "name": "cinema-watch",
  "version": "0.0.0",
  "description": "Cacce ai biglietti UCI Cinemas: avvisi Telegram con la pianta della sala quando escono gli spettacoli o si liberano posti buoni.",
  "license": "MIT",
  "author": "Filippo Scatigna (PilaScat)",
  "repository": {
    "type": "git",
    "url": "https://github.com/PilaScat/cinema-watch.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
